TELEGRAM_TOKEN=your_constructor_bot_token_here
BOT_TOKENS=
DATABASE_URL=sqlite+aiosqlite:///./constructor.db
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
PUBLIC_BASE_URL=https://your-app.onrender.com
# Long random string; encrypts child-bot tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ENCRYPTION_KEY=
# Turn on after one deploy (all webhooks re-registered with the secret header)
WEBHOOK_SECRET_ENFORCE=False
WEBHOOK_REFRESH_ON_START=True
LOG_LEVEL=INFO
LOG_FORMAT=json
MAX_CONNECTIONS=20
CONNECTION_POOL_SIZE=10
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
ADMIN_IDS=
DEBUG=False
TESTING=False
